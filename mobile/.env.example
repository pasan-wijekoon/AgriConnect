# Backend API Base URL Options:
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator / Local Web / Windows / macOS: http://localhost:5000/api
# - Physical Device (same Wi-Fi LAN): http://<YOUR_LOCAL_IP>:5000/api (e.g. http://192.168.1.100:5000/api)
API_BASE_URL=http://10.0.2.2:5000/api

