      SELECT s."ListingId", COALESCE(sum(s."ReservedQuantity"), 0.0) AS "Reserved"&#xD;
      FROM "StockReservation" AS s&#xD;
      INNER JOIN "Order" AS o ON s."OrderId" = o."Id"&#xD;
      WHERE (o."Status" IN ('Approved', 'Scheduled', 'Completed') OR (o."Status" = 'Pending' AND s."ExpiresAt" &gt; @now)) AND s."ListingId" = ANY (@listingIds)&#xD;
      GROUP BY s."ListingId"&#xD;
