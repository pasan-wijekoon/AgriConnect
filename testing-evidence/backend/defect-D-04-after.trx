      SELECT l."Id", l."ClaimedGrade", l."CreatedAt", l."CropId", l."Description", l."FarmerId", l."MinPrice", l."PickupWindowEnd", l."PickupWindowStart", l."Quantity", l."RegionId", l."Status", l."Unit", l."UpdatedAt", c."Id", c."Category", c."CreatedAt", c."Name", r."Id", r."CollectionCentreId", r."CreatedAt", r."Name"&#xD;
      FROM "Listings" AS l&#xD;
      INNER JOIN "Crop" AS c ON l."CropId" = c."Id"&#xD;
