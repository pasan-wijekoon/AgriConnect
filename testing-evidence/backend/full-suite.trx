      Executed DbCommand (7ms) [Parameters=[@order_ListingId='?' (DbType = Guid), @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT COALESCE(sum(s."ReservedQuantity"), 0.0)&#xD;
      FROM "StockReservation" AS s&#xD;
      INNER JOIN "Order" AS o ON s."OrderId" = o."Id"&#xD;
      WHERE s."ListingId" = @order_ListingId AND (o."Status" IN ('Approved', 'Scheduled', 'Completed') OR (o."Status" = 'Pending' AND s."ExpiresAt" &gt; @now))&#xD;
