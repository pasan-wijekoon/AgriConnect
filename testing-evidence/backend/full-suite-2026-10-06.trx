      SELECT s."Id", s."BuyerReminderSentAt", s."ExpiresAt", s."ListingId", s."OfficerReminderSentAt", s."OrderId", s."ReservedQuantity", o."Id", o."BuyerId", o."BuyerLatitude", o."BuyerLongitude", o."CreatedAt", o."DeliveryPreference", o."ListingId", o."Quantity", o."Status", o."UpdatedAt"&#xD;
