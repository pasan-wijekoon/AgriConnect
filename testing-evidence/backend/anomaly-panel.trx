      FROM (&#xD;
          SELECT l."Id", l."ClaimedGrade", l."CreatedAt", l."CropId", l."Description", l."FarmerId", l."MinPrice", l."PickupWindowEnd", l."PickupWindowStart", l."Quantity", l."RegionId", l."Status", l."Unit", l."UpdatedAt", c."Id" AS "Id0", c."Category", c."CreatedAt" AS "CreatedAt0", c."Name", r."Id" AS "Id1", r."CollectionCentreId", r."CreatedAt" AS "CreatedAt1", r."Name" AS "Name0", p."Id" AS "Id2", p."AgentWorkflowId", p."AutoRejectedByValidation", p."CheckpointName", p."Confidence", p."CreatedAt" AS "CreatedAt2", p."DecidedAt", p."DecidedByUserId", p."ListingId", p."OfficerNote", p."ReasoningSummary", p."Status" AS "Status0", p."SuggestedPriceMax", p."SuggestedPriceMin", p."UpdatedAt" AS "UpdatedAt0", p."ValidationSummary"&#xD;
          FROM "Listings" AS l&#xD;
          INNER JOIN "Crop" AS c ON l."CropId" = c."Id"&#xD;
