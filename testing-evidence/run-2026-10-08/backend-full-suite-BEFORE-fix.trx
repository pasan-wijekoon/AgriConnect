      SELECT o."Id", o."BuyerId", o."BuyerLatitude", o."BuyerLongitude", o."CreatedAt", o."DeliveryPreference", o."ListingId", o."Quantity", o."Status", o."UpdatedAt"&#xD;
      FROM "Order" AS o&#xD;
