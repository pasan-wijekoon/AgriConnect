      Executed DbCommand (65ms) [Parameters=[@listingIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT l."Id", l."FarmerId", l."Unit", l."RegionId", c."Name", r."Name"&#xD;
