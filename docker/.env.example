# ==============================================================================
# AgriConnect Docker Environment Configuration
# Copy this file to .env before running docker compose
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_DB=agriconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend API (.NET 10) ---
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=postgres;Port=5432;Database=agriconnect;Username=postgres;Password=postgres

# --- Agentic AI Service (FastAPI) ---
AGENTIC_AI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
LLM_PROVIDER=mock
DEFAULT_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
# OSRM's public demo server — free, unlimited, no API key required.
MAPS_API_BASE_URL=https://router.project-osrm.org/
MAPS_API_KEY=
INTERNAL_API_SECRET=dev-secret-key-12345
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

# --- Web Frontend (React Vite / Nginx) ---
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:5000
