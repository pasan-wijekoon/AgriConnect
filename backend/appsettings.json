{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;port=5432;Database=agriconnect;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "dev-secret-key-change-in-production",
    "Issuer": "AgriConnect",
    "Audience": "AgriConnect",
    "ExpiryHours": "12"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:5174" ]
  },
  "Orders": {
    "ReservationTtlMinutes": 2880,
    "ExpirySweepIntervalMinutes": 5
  },
  "Centres": {
    "MaxNearestDistanceKm": 200
  },
  "MapsApi": {
    "BaseUrl": "https://router.project-osrm.org/",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "MaxRetries": 2
  },
  "AgenticAi": {
    "BaseUrl": "http://localhost:8000/",
    "ApiKey": "",
    "TimeoutSeconds": 5
  },
  "Analytics": {
    "AnomalyThresholdPercent": 25.0
  }
}
