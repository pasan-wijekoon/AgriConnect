{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=agriconnect;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "AgriConnect.Api",
    "Audience": "AgriConnect.Clients",
    "SecretKey": "dev-secret-key-change-in-production",
    "ExpiryMinutes": 60
  },
  "Orders": {
    "ReservationTtlMinutes": 30,
    "ExpirySweepIntervalMinutes": 5
  },
  "MapsApi": {
    "BaseUrl": "https://router.project-osrm.org/",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "MaxRetries": 2
  },
  "AgenticAi": {
    "BaseUrl": "http://localhost:8000/",
    "ApiKey": "",
    "TimeoutSeconds": 5
  },
  "Analytics": {
    "AnomalyThresholdPercent": 25.0
  }
}
