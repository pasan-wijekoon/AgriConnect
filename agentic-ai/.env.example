# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration (options: mock, gemini, openai)
LLM_PROVIDER=mock
DEFAULT_MODEL=gemini-1.5-flash

# API Keys (optional when LLM_PROVIDER=mock)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maps & Distance Service — OSRM's public demo server (free, unlimited, no API key required)
MAPS_API_BASE_URL=https://router.project-osrm.org/
MAPS_API_KEY=

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173
INTERNAL_API_SECRET=dev-secret-key-12345