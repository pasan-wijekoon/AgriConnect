# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration (options: mock, gemini, openai)
LLM_PROVIDER=mock
DEFAULT_MODEL=gemini-3.8-flash

# API Keys (optional when LLM_PROVIDER=mock)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway instead of api.openai.com.
# OpenCode Zen (free models, e.g. DEFAULT_MODEL=longcat-2.5-preview-free):
#   OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_BASE_URL=

# Tool data: mock or api. Leave empty to follow LLM_PROVIDER (mock -> mock, else api).
# Use TOOLS_MODE=mock to try a real LLM before Component B's endpoints exist.
TOOLS_MODE=

# ASP.NET Core API — data source for agent tools when TOOLS_MODE=api
BACKEND_API_BASE_URL=http://localhost:5000
TOOL_TIMEOUT_SECONDS=10

# Maps & Distance Service
MAPS_API_BASE_URL=https://api.openrouteservice.org
MAPS_API_KEY=

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173
INTERNAL_API_SECRET=dev-secret-key-12345